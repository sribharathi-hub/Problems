class Solution {
    public int lengthOfLongestSubstring(String s) {
        int str=0,ml=0;
        int a[] = new int[256];
        for(int i=0;i<s.length();i++)
        {
            char b = s.charAt(i);
            if(a[b]>str)
            {
                str=a[b];
            }
            a[b] = i+1;
            ml = Math.max(ml,i+1-str);
        }
        return ml;
    }
}
